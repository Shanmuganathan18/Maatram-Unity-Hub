# ─────────────────────────────────────────────────────────────────────────────
# Maatram Student Availability Planner — Backend Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (MySQL via Prisma) ───────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:yourpassword@localhost:3306/maatram_db"

# ── Supabase (REQUIRED for Auth) ──────────────────────────────────────────────
# From your Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Service role key: Backend ONLY. Never send to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# JWT Secret: Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── CORS — allowed frontend origins ──────────────────────────────────────────
FRONTEND_STUDENT_URL=http://localhost:5173
FRONTEND_OFFICER_URL=http://localhost:5174
FRONTEND_ADMIN_URL=http://localhost:5175

# ── Email (Nodemailer / SMTP) ─────────────────────────────────────────────────
# Example using Gmail App Password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
# Example using SendGrid:
#   SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=SG.xxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
EMAIL_FROM="Maatram Foundation <noreply@maatram-demo.example>"

# ── SMS / WhatsApp (optional — leave blank to disable channel) ────────────────
# Twilio example:
SMS_PROVIDER=        # twilio | msg91 | (blank = disabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── File Storage ──────────────────────────────────────────────────────────────
# LOCAL (development): files saved to ./uploads/
# PRODUCTION: set STORAGE_PROVIDER=s3 and fill AWS_* values
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ── Application settings ──────────────────────────────────────────────────────
# Timezone used for scheduled jobs and deadline calculations
APP_TIMEZONE=Asia/Kolkata
# Base URL of this backend (used in email links)
API_BASE_URL=http://localhost:5000
# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# Auth rate limit (stricter for login endpoints)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# Set to true to write logs to files in ./logs/
LOG_TO_FILE=false

