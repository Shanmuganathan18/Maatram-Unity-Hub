// prisma/schema.prisma
// Maatram Student Availability Planner — Complete MySQL Schema
// Generated by: Principal Backend Architect
// ORM: Prisma 5.x
// Database: MySQL 8.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum UserRole {
  STUDENT
  OFFICER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_ACTIVATION
}

enum ZoneStatus {
  ACTIVE
  INACTIVE
}

enum InstitutionStatus {
  ACTIVE
  ONBOARDING
  INACTIVE
}

enum AvailabilityStatus {
  DRAFT
  SUBMITTED
}

enum DayAvailability {
  AVAILABLE
  UNAVAILABLE
  NONE
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum EventCategory {
  COLLEGE_VISIT
  BOOT_CAMP
  MOCK_TRAINING
  MOCK_INTERVIEW
  ONLINE_SESSION
  PHYSICAL_VERIFICATION
  OTHER
}

enum EventMode {
  PHYSICAL
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  INVITATIONS_OPEN
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED
}

enum InvitationResponse {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  WAITLISTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum QuestionType {
  TEXT
  TEXTAREA
  RADIO
  CHECKBOX
  SELECT
  YESNO
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
}

enum AnnouncementAudience {
  ALL_STUDENTS
  ALL_OFFICERS
  ALL_ADMINS
  ALL_USERS
  SELECTED_ZONES
  SELECTED_INSTITUTIONS
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  PREVIEWED
  IMPORTED
  FAILED
}

// ═══════════════════════════════════════════════════════════════════════════════
// IDENTITY & ACCESS
// ═══════════════════════════════════════════════════════════════════════════════

/// Central user record — one per Supabase Auth account.
model User {
  id           String        @id @default(uuid())
  supabaseUid  String        @unique @map("supabase_uid") @db.VarChar(255)
  email        String        @unique @db.VarChar(255)
  role         UserRole
  status       AccountStatus @default(PENDING_ACTIVATION)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  lastLoginAt  DateTime?     @map("last_login_at")

  studentProfile    StudentProfile?
  officerProfile    OfficerProfile?
  adminProfile      AdminProfile?
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  supportTickets    SupportTicket[]  @relation("TicketSubmitter")
  assignedTickets   SupportTicket[]  @relation("TicketAssignee")
  supportMessages   SupportMessage[]
  auditLogs         AuditLog[]
  activityLogs      ActivityLog[]
  announcementsCreated Announcement[]
  attendanceRecorded   Attendance[]
  settingsUpdated      SystemSetting[]
  emailDeliveryLogs    EmailDeliveryLog[]

  @@map("users")
  @@index([role])
  @@index([status])
}

/// Student-specific profile data
model StudentProfile {
  id            String        @id @default(uuid())
  userId        String        @unique @map("user_id")
  studentId     String        @unique @map("student_id") @db.VarChar(50) // e.g. MF-A-0001
  registerNumber String?      @map("register_number") @db.VarChar(100) // College Reg/Roll No
  name          String        @db.VarChar(150)
  phone         String?       @db.VarChar(20)
  gender        String?       @db.VarChar(20)
  course        String?       @db.VarChar(100)
  academicYear  String?       @map("academic_year") @db.VarChar(50)
  photoUrl      String?       @map("photo_url") @db.VarChar(500)
  alternateEmail String?      @map("alternate_email") @db.VarChar(255)
  whatsappEnabled Boolean     @default(false) @map("whatsapp_enabled")
  institutionId String        @map("institution_id")
  departmentId  String?       @map("department_id")
  year          Int           @default(1)
  zoneId        String        @map("zone_id")
  groups        Json          @default("[]") // Array of group strings e.g. ["Batch-1"]
  status        AccountStatus @default(PENDING_ACTIVATION)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution          Institution            @relation(fields: [institutionId], references: [id])
  department           Department?            @relation(fields: [departmentId], references: [id])
  zone                 Zone                   @relation(fields: [zoneId], references: [id])
  availabilitySubmissions AvailabilitySubmission[]
  availabilityTemplates   AvailabilityTemplate[]
  eventInvitations        EventInvitation[]

  @@map("student_profiles")
  @@index([registerNumber])
  @@index([zoneId])
  @@index([institutionId])
  @@index([departmentId])
  @@index([status])
}

/// Officer-specific profile data
model OfficerProfile {
  id          String        @id @default(uuid())
  userId      String        @unique @map("user_id")
  officerId   String        @unique @map("officer_id") @db.VarChar(50) // e.g. OFF-A-001
  employeeId  String?       @map("employee_id") @db.VarChar(100)
  name        String        @db.VarChar(150)
  phone       String?       @db.VarChar(20)
  designation String        @db.VarChar(100)
  photoUrl    String?       @map("photo_url") @db.VarChar(500)
  zoneId      String?       @map("zone_id") // Nullable — officer may be unassigned
  status      AccountStatus @default(PENDING_ACTIVATION)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone  Zone? @relation(fields: [zoneId], references: [id])
  eventsCreated Event[]

  @@map("officer_profiles")
  @@index([employeeId])
  @@index([zoneId])
  @@index([status])
}

/// Admin-specific profile data
model AdminProfile {
  id        String        @id @default(uuid())
  userId    String        @unique @map("user_id")
  adminId   String        @unique @map("admin_id") @db.VarChar(50) // e.g. ADM-001
  name      String        @db.VarChar(150)
  phone     String?       @db.VarChar(20)
  photoUrl  String?       @map("photo_url") @db.VarChar(500)
  roleId    String        @map("role_id")
  status    AccountStatus @default(PENDING_ACTIVATION)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          AppRole       @relation(fields: [roleId], references: [id])

  @@map("admin_profiles")
  @@index([roleId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ROLES & PERMISSIONS
// ═══════════════════════════════════════════════════════════════════════════════

/// System role (admin)
model AppRole {
  id          String   @id @db.VarChar(50) // e.g. 'super_admin'
  label       String   @db.VarChar(100)
  description String?  @db.Text
  editable    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  adminProfiles AdminProfile[]
  permissions   RolePermission[]

  @@map("app_roles")
}

/// Individual permission capability
model Permission {
  key   String @id @db.VarChar(100) // e.g. 'zones.create'
  label String @db.VarChar(200)
  group String @db.VarChar(100)

  roles         RolePermission[]
  permissionHistory PermissionHistory[]

  @@map("permissions")
}

/// Many-to-many: role ↔ permission
model RolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role       AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// Audit trail for permission changes
model PermissionHistory {
  id            String   @id @default(uuid())
  permissionKey String   @map("permission_key")
  roleId        String   @map("role_id")
  action        String   @db.VarChar(50) // 'granted' | 'revoked'
  actorId       String   @map("actor_id")
  actorName     String   @map("actor_name") @db.VarChar(150)
  note          String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  permission Permission @relation(fields: [permissionKey], references: [key])

  @@map("permission_history")
  @@index([roleId])
  @@index([permissionKey])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ORGANISATION
// ═══════════════════════════════════════════════════════════════════════════════

model Zone {
  id          String     @id @default(uuid())
  code        String     @unique @db.VarChar(20) // e.g. ZN-A
  name        String     @db.VarChar(100)
  region      String     @db.VarChar(100)
  description String?    @db.Text
  status      ZoneStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  institutions    Institution[]
  officerProfiles OfficerProfile[]
  studentProfiles StudentProfile[]
  events          Event[]
  activityLogs    ActivityLog[]
  auditLogs       AuditLog[]

  @@map("zones")
  @@index([status])
}

model Institution {
  id           String            @id @default(uuid())
  code         String            @db.VarChar(20)  // e.g. SVIT (not globally unique; unique within zone)
  name         String            @db.VarChar(255)
  location     String            @db.VarChar(150)
  type         String            @db.VarChar(100) // Engineering, Arts & Science, etc.
  zoneId       String?           @map("zone_id")  // Nullable for unassigned
  contactName  String?           @map("contact_name") @db.VarChar(150)
  contactEmail String?           @map("contact_email") @db.VarChar(255)
  contactPhone String?           @map("contact_phone") @db.VarChar(20)
  status       InstitutionStatus @default(ACTIVE)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  zone            Zone?              @relation(fields: [zoneId], references: [id])
  departments     Department[]
  studentProfiles StudentProfile[]
  eventTargets    EventTargetInstitution[]

  @@unique([code, zoneId]) // Code is unique within a zone
  @@map("institutions")
  @@index([zoneId])
  @@index([status])
}

model Department {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String   @db.VarChar(150) // e.g. B.Tech IT, MBA, Diploma CSE
  level         String?  @db.VarChar(50)  // UG, PG, Diploma
  createdAt     DateTime @default(now()) @map("created_at")

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentProfiles StudentProfile[]

  @@unique([institutionId, name])
  @@map("departments")
  @@index([institutionId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// STUDENT AVAILABILITY
// ═══════════════════════════════════════════════════════════════════════════════

/// One record per student per week
model AvailabilitySubmission {
  id               String             @id @default(uuid())
  studentProfileId String             @map("student_profile_id")
  weekStart        String             @map("week_start") @db.VarChar(10) // YYYY-MM-DD (Monday)
  weekEnd          String             @map("week_end") @db.VarChar(10)   // YYYY-MM-DD (Sunday)
  status           AvailabilityStatus @default(DRAFT)
  deadlineAt       DateTime           @map("deadline_at")
  locked           Boolean            @default(false)
  submittedAt      DateTime?          @map("submitted_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  studentProfile StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  days           AvailabilityDay[]
  history        AvailabilityHistory[]

  @@unique([studentProfileId, weekStart])
  @@map("availability_submissions")
  @@index([studentProfileId])
  @@index([weekStart])
  @@index([status])
}

/// One record per date within a submission (7 per week)
model AvailabilityDay {
  id           String          @id @default(uuid())
  submissionId String          @map("submission_id")
  date         String          @db.VarChar(10)  // YYYY-MM-DD
  availability DayAvailability @default(NONE)

  submission AvailabilitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  slots      AvailabilitySlot[]

  @@unique([submissionId, date])
  @@map("availability_days")
  @@index([submissionId])
  @@index([date])
  @@index([availability])
}

/// Time-slot selection within an Available day (morning/afternoon/evening)
model AvailabilitySlot {
  id    String   @id @default(uuid())
  dayId String   @map("day_id")
  slot  TimeSlot

  day AvailabilityDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId, slot])
  @@map("availability_slots")
  @@index([dayId])
}

/// Audit history for edits to a submitted week
model AvailabilityHistory {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  type         String   @db.VarChar(50) // 'submitted' | 'updated'
  changes      Json     @default("[]")  // Array of {date, from, to}
  createdAt    DateTime @default(now()) @map("created_at")

  submission AvailabilitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("availability_history")
  @@index([submissionId])
}

/// Saved weekly pattern template (student-owned)
model AvailabilityTemplate {
  id               String   @id @default(uuid())
  studentProfileId String   @map("student_profile_id")
  name             String   @db.VarChar(100)
  pattern          Json     // Array of 7 day objects {status, slots}
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, name])
  @@map("availability_templates")
  @@index([studentProfileId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// EVENTS
// ═══════════════════════════════════════════════════════════════════════════════

model Event {
  id               String        @id @default(uuid())
  zoneId           String        @map("zone_id")
  createdById      String        @map("created_by_id") // OfficerProfile.id
  title            String        @db.VarChar(255)
  category         EventCategory
  description      String?       @db.Text
  date             String        @db.VarChar(10)   // YYYY-MM-DD
  startTime        String?       @map("start_time") @db.VarChar(5)  // HH:mm
  endTime          String?       @map("end_time") @db.VarChar(5)
  mode             EventMode     @default(PHYSICAL)
  venue            String?       @db.VarChar(255)
  address          String?       @db.Text
  platform         String?       @db.VarChar(100) // Zoom, Google Meet, etc.
  meetingLink      String?       @map("meeting_link") @db.VarChar(500)
  instructions     String?       @db.Text
  status           EventStatus   @default(DRAFT)
  capacity         Int?
  waitlistEnabled  Boolean       @default(false) @map("waitlist_enabled")
  responseDeadline DateTime?     @map("response_deadline")
  originalDate     String?       @map("original_date") @db.VarChar(10)
  statusNote       String?       @map("status_note") @db.Text
  approvalStatus   String        @default("approved") @map("approval_status") @db.VarChar(50)
  // Audience filters (stored denormalized for performance; also resolved dynamically)
  targetYears      Json          @default("[]") @map("target_years")     // e.g. [3,4]
  targetGroups     Json          @default("[]") @map("target_groups")    // e.g. ["Batch-1"]
  targetDepts      Json          @default("[]") @map("target_depts")     // e.g. ["CSE"]
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  zone            Zone                     @relation(fields: [zoneId], references: [id])
  createdBy       OfficerProfile           @relation(fields: [createdById], references: [id])
  targetInstitutions EventTargetInstitution[]
  questions       EventQuestion[]
  invitations     EventInvitation[]
  statusHistory   EventStatusHistory[]

  @@map("events")
  @@index([zoneId])
  @@index([status])
  @@index([date])
  @@index([category])
  @@index([createdById])
}

model EventTargetInstitution {
  id            String @id @default(uuid())
  eventId       String @map("event_id")
  institutionId String @map("institution_id")

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([eventId, institutionId])
  @@map("event_target_institutions")
  @@index([eventId])
  @@index([institutionId])
}

model EventQuestion {
  id       String       @id @default(uuid())
  eventId  String       @map("event_id")
  type     QuestionType
  label    String       @db.Text
  required Boolean      @default(false)
  order    Int          @default(0)
  options  Json         @default("[]") // For RADIO/SELECT/CHECKBOX questions

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers EventAnswer[]

  @@map("event_questions")
  @@index([eventId])
}

model EventStatusHistory {
  id        String      @id @default(uuid())
  eventId   String      @map("event_id")
  fromStatus EventStatus? @map("from_status")
  toStatus  EventStatus @map("to_status")
  note      String?     @db.Text
  actorId   String?     @map("actor_id")
  actorName String?     @map("actor_name") @db.VarChar(150)
  createdAt DateTime    @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_status_history")
  @@index([eventId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// INVITATIONS & RESPONSES
// ═══════════════════════════════════════════════════════════════════════════════

/// One invitation per student per event (unique constraint enforced)
model EventInvitation {
  id               String             @id @default(uuid())
  eventId          String             @map("event_id")
  studentProfileId String             @map("student_profile_id")
  response         InvitationResponse @default(PENDING)
  declineReason    String?            @map("decline_reason") @db.Text
  invitedAt        DateTime           @default(now()) @map("invited_at")
  respondedAt      DateTime?          @map("responded_at")
  reminderSentAt   DateTime?          @map("reminder_sent_at")

  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile   @relation(fields: [studentProfileId], references: [id])
  answers        EventAnswer[]
  attendance     Attendance?

  @@unique([eventId, studentProfileId])
  @@map("event_invitations")
  @@index([eventId])
  @@index([studentProfileId])
  @@index([response])
}

model EventAnswer {
  id           String @id @default(uuid())
  invitationId String @map("invitation_id")
  questionId   String @map("question_id")
  answer       String @db.Text

  invitation EventInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  question   EventQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([invitationId, questionId])
  @@map("event_answers")
  @@index([invitationId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ATTENDANCE
// ═══════════════════════════════════════════════════════════════════════════════

model Attendance {
  id           String          @id @default(uuid())
  invitationId String          @unique @map("invitation_id") // One attendance per invitation
  status       AttendanceStatus
  note         String?         @db.Text
  recordedById String          @map("recorded_by_id") // User.id of officer/admin
  recordedAt   DateTime        @default(now()) @map("recorded_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  invitation EventInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  recordedBy User            @relation(fields: [recordedById], references: [id])
  history    AttendanceHistory[]

  @@map("attendance")
  @@index([invitationId])
  @@index([status])
}

model AttendanceHistory {
  id           String          @id @default(uuid())
  attendanceId String          @map("attendance_id")
  fromStatus   AttendanceStatus? @map("from_status")
  toStatus     AttendanceStatus @map("to_status")
  note         String?         @db.Text
  actorId      String          @map("actor_id")
  actorName    String          @map("actor_name") @db.VarChar(150)
  createdAt    DateTime        @default(now()) @map("created_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("attendance_history")
  @@index([attendanceId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  category   String   @db.VarChar(100) // availability_reminder | event_invitation | etc.
  title      String   @db.VarChar(255)
  body       String   @db.Text
  read       Boolean  @default(false)
  link       Json?    // {type: 'event', eventId: 'xxx'} etc.
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  readAt     DateTime? @map("read_at")

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@map("notifications")
  @@index([userId])
  @@index([read])
  @@index([category])
  @@index([createdAt])
}

model NotificationDelivery {
  id             String              @id @default(uuid())
  notificationId String              @map("notification_id")
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  attempts       Int                 @default(0)
  providerRef    String?             @map("provider_ref") @db.VarChar(255)
  errorReason    String?             @map("error_reason") @db.Text
  sentAt         DateTime?           @map("sent_at")
  deliveredAt    DateTime?           @map("delivered_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("notification_deliveries")
  @@index([notificationId])
  @@index([status])
  @@index([channel])
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  category  String   @db.VarChar(100)
  inApp     Boolean  @default(true) @map("in_app")
  email     Boolean  @default(true)
  sms       Boolean  @default(false)
  whatsapp  Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// EMAIL DELIVERY LOGS
// ═══════════════════════════════════════════════════════════════════════════════

enum EmailDeliveryStatus {
  QUEUED
  PROCESSING
  SMTP_ACCEPTED
  SENT
  FAILED
  CANCELLED
}

model EmailDeliveryLog {
  id               String              @id @default(uuid())
  recipientEmail   String              @map("recipient_email") @db.VarChar(255)
  recipientName    String?             @map("recipient_name") @db.VarChar(150)
  recipientRole    UserRole            @map("recipient_role")
  notificationType String              @map("notification_type") @db.VarChar(100) // ACCOUNT_ACTIVATION, PASSWORD_RESET, etc.
  subject          String              @db.VarChar(255)
  userId           String?             @map("user_id")
  status           EmailDeliveryStatus @default(QUEUED)
  attemptCount     Int                 @default(0) @map("attempt_count")
  maxAttempts      Int                 @default(5) @map("max_attempts")
  idempotencyKey   String?             @unique @map("idempotency_key") @db.VarChar(255)
  nextRetryAt      DateTime?           @map("next_retry_at")
  lockedAt         DateTime?           @map("locked_at")
  lockedBy         String?             @map("locked_by") @db.VarChar(100)
  providerResponse String?             @map("provider_response") @db.Text
  errorDetails     String?             @map("error_details") @db.Text
  metadata         Json?               // Safe metadata: { portalUrl, institutionName, zoneName, etc. } - NO PASSWORDS
  sentAt           DateTime?           @map("sent_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("email_delivery_logs")
  @@index([recipientEmail])
  @@index([recipientRole])
  @@index([status])
  @@index([notificationType])
  @@index([createdAt])
  @@index([userId])
  @@index([nextRetryAt])
  @@index([status, nextRetryAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ANNOUNCEMENTS
// ═══════════════════════════════════════════════════════════════════════════════

model Announcement {
  id          String               @id @default(uuid())
  createdById String               @map("created_by_id")
  title       String               @db.VarChar(255)
  body        String               @db.Text
  audience    AnnouncementAudience
  targetZoneIds Json               @default("[]") @map("target_zone_ids")
  targetInstIds Json               @default("[]") @map("target_inst_ids")
  status      AnnouncementStatus   @default(DRAFT)
  publishAt   DateTime?            @map("publish_at")
  expiresAt   DateTime?            @map("expires_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("announcements")
  @@index([status])
  @@index([publishAt])
  @@index([audience])
}

// ═══════════════════════════════════════════════════════════════════════════════
// SUPPORT TICKETS
// ═══════════════════════════════════════════════════════════════════════════════

model SupportTicket {
  id          String         @id @default(uuid())
  submittedById String       @map("submitted_by_id")
  assigneeId  String?        @map("assignee_id")
  subject     String         @db.VarChar(255)
  category    String         @db.VarChar(100)
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  zoneId      String?        @map("zone_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  resolvedAt  DateTime?      @map("resolved_at")

  submittedBy   User           @relation("TicketSubmitter", fields: [submittedById], references: [id])
  assignee      User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages      SupportMessage[]
  statusHistory SupportStatusHistory[]

  @@map("support_tickets")
  @@index([status])
  @@index([priority])
  @@index([submittedById])
  @@index([assigneeId])
  @@index([zoneId])
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  authorId  String   @map("author_id")
  text      String   @db.Text
  internal  Boolean  @default(false) // Internal notes not visible to submitter
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@map("support_messages")
  @@index([ticketId])
}

model SupportStatusHistory {
  id         String       @id @default(uuid())
  ticketId   String       @map("ticket_id")
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus  @map("to_status")
  actorId    String        @map("actor_id")
  actorName  String        @map("actor_name") @db.VarChar(150)
  note       String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("support_status_history")
  @@index([ticketId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ADMINISTRATION & AUDIT
// ═══════════════════════════════════════════════════════════════════════════════

/// Zone-level officer actions (officer activity log)
model ActivityLog {
  id          String   @id @default(uuid())
  zoneId      String?  @map("zone_id")
  actorId     String   @map("actor_id") // User.id
  actorName   String   @map("actor_name") @db.VarChar(150)
  type        String   @db.VarChar(100) // event_created | invitation_sent | attendance_updated | etc.
  description String   @db.Text
  related     Json?    // {type: 'event', id: 'xxx', label: 'Boot Camp'}
  createdAt   DateTime @default(now()) @map("created_at")

  zone  Zone? @relation(fields: [zoneId], references: [id])
  actor User  @relation(fields: [actorId], references: [id])

  @@map("activity_logs")
  @@index([zoneId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}

/// System-wide immutable audit log — no UPDATE or DELETE allowed via API
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  actorName   String   @map("actor_name") @db.VarChar(150)
  actorRole   String   @map("actor_role") @db.VarChar(50)
  action      String   @db.VarChar(100) // zone.created | officer.deactivated | role.updated | etc.
  category    String   @db.VarChar(100)
  description String   @db.Text
  zoneId      String?  @map("zone_id")
  related     Json?    // Related entity reference
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  actor User  @relation(fields: [actorId], references: [id])
  zone  Zone? @relation(fields: [zoneId], references: [id])

  @@map("audit_logs")
  @@index([actorId])
  @@index([action])
  @@index([category])
  @@index([zoneId])
  @@index([createdAt])
}

/// Configurable system settings (key-value)
model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("system_settings")
}

/// Bulk import jobs
model DataImportJob {
  id           String       @id @default(uuid())
  uploadedById String       @map("uploaded_by_id")
  fileName     String       @map("file_name") @db.VarChar(255)
  entityType   String       @map("entity_type") @db.VarChar(50) // 'students' | 'institutions'
  targetZoneId String?      @map("target_zone_id")
  totalRows    Int          @default(0) @map("total_rows")
  validRows    Int          @default(0) @map("valid_rows")
  invalidRows  Int          @default(0) @map("invalid_rows")
  status       ImportStatus @default(UPLOADED)
  commonPasswordUsed Boolean  @default(false) @map("common_password_used")
  summary      Json         @default("{}")
  errorReportUrl String?    @map("error_report_url") @db.VarChar(500)
  errors       Json         @default("[]") // Array of {row, field, message}
  createdAt    DateTime     @default(now()) @map("created_at")
  completedAt  DateTime?    @map("completed_at")

  @@map("data_import_jobs")
  @@index([uploadedById])
  @@index([status])
}

/// Event feedback (post-event from students)
model EventFeedback {
  id               String   @id @default(uuid())
  eventId          String   @map("event_id")
  studentProfileId String   @map("student_profile_id")
  rating           Int      // 1–5
  comment          String?  @db.Text
  suggestion       String?  @db.Text
  submittedAt      DateTime @default(now()) @map("submitted_at")

  @@unique([eventId, studentProfileId])
  @@map("event_feedback")
  @@index([eventId])
  @@index([studentProfileId])
}

